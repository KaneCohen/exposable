<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.5/phpunit.xsd" bootstrap="tests/bootstrap.php" colors="true" failOnWarning="true" failOnRisky="true" failOnDeprecation="true" failOnPhpunitDeprecation="true" cacheDirectory="build/phpunit">
  <php>
    <ini name="error_reporting" value="32767"/>
  </php>
  <testsuites>
    <testsuite name="Exposable">
      <directory>tests/Unit</directory>
      <directory>tests/Integration</directory>
    </testsuite>
  </testsuites>
  <source restrictDeprecations="true">
    <include>
      <directory suffix=".php">src</directory>
    </include>
  </source>
</phpunit>
