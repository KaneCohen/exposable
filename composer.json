{
  "name": "arjanwestdorp/exposable",
  "description": "A laravel package to expose protected model in a secure way.",
  "keywords": [
    "arjan",
    "westdorp",
    "laravel",
    "expose"
  ],
  "homepage": "https://github.com/arjanwestdorp/exposable",
  "license": "MIT",
  "authors": [
    {
      "name": "Arjan Westdorp",
      "email": "arjanwestdorp@gmail.com",
      "homepage": "https://www.trait-development.nl",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "~8.4.0",
    "laravel/framework": "^10.50.3 || ^11.57.0 || ^12.69.3 || ^13.34.0",
    "league/uri": "^7.8.1",
    "league/uri-components": "^7.8.1",
    "nesbot/carbon": "^2.73.0 || ^3.8.4"
  },
  "require-dev": {
    "mockery/mockery": "^1.6.15",
    "orchestra/testbench": "^8.39.0 || ^9.18.0 || ^10.12.0 || ^11.3.0",
    "phpunit/phpunit": "^10.5.66 || ^11.5.57"
  },
  "autoload": {
    "psr-4": {
      "ArjanWestdorp\\Exposable\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "ArjanWestdorp\\Exposable\\Test\\": "tests"
    }
  },
  "scripts": {
    "test": "@php -d error_reporting=32767 tools/test.php"
  },
  "config": {
    "sort-packages": true
  }
}
